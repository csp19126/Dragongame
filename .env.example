# Copy to .env for local development. Never commit .env.

# The only required setting
DATABASE_URL=postgresql://user:password@localhost:5432/dragongame

# Optional. If unset, a strong secret is generated once and stored in the database.
SESSION_SECRET=

# Optional. Comma-separated usernames that get the Admin panel.
ADMIN_USERNAMES=

# Optional. Defaults to 5000.
PORT=5000
